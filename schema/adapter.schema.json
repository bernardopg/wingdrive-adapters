{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bernardopg/wingdrive-adapters/schema/adapter.schema.json",
  "title": "WingDrive adapter manifest (adapter.toml, contract 1)",
  "type": "object",
  "required": ["adapter"],
  "properties": {
    "adapter": {
      "type": "object",
      "required": ["id", "name", "summary", "version", "author", "license", "icon", "contract", "runtime", "platforms"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 40 },
        "summary": { "type": "string", "minLength": 10, "maxLength": 140 },
        "description": { "type": "string", "maxLength": 4000 },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "author": { "type": "string", "minLength": 2, "maxLength": 80 },
        "license": { "type": "string", "minLength": 2, "maxLength": 40 },
        "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
        "icon": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.svg$" },
        "categories": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["notes", "mail", "chat", "code", "browser", "calendar", "contacts", "media", "documents", "ai", "other"] }
        },
        "contract": { "const": 1 },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["linux", "macos", "windows"] }
        },
        "runtime": {
          "type": "object",
          "required": ["kind", "entry"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["python3", "binary"] },
            "entry": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" },
            "python": { "type": "string", "pattern": "^3\\.[0-9]+$" },
            "timeout": { "type": "integer", "minimum": 10, "maximum": 3600 },
            "schedule": { "type": "string", "maxLength": 64 }
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
            "network": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^(\\*\\.)?[a-z0-9.-]+\\.[a-z]{2,}$" }
            },
            "secrets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$" } },
            "tools": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,40}$" } }
          }
        },
        "config": { "type": "array", "items": { "type": "object" } }
      }
    },
    "data_type": { "type": "object" },
    "models": { "type": "object" },
    "search": { "type": "object" }
  }
}
