{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bernardopg/wingdrive-adapters/schema/index.schema.json",
  "title": "WingDrive adapter index (index.json, format 1)",
  "description": "Built by tools/wingreg from registry/ and signed with minisign. The app refuses an index whose signature does not verify or whose sequence is lower than the last one it accepted.",
  "type": "object",
  "required": ["format", "sequence", "generated_at", "registry", "adapters", "revoked"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "registry": { "type": "string", "pattern": "^https://" },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "summary", "version", "author", "license", "trust", "contract", "runtime", "platforms", "permissions", "source", "icon", "artifacts"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "summary": { "type": "string" },
          "description": { "type": "string" },
          "version": { "type": "string" },
          "author": { "type": "string" },
          "license": { "type": "string" },
          "homepage": { "type": "string" },
          "categories": { "type": "array", "items": { "type": "string" } },
          "trust": { "enum": ["official", "verified", "community"] },
          "contract": { "type": "integer" },
          "runtime": { "type": "object" },
          "platforms": { "type": "array", "items": { "type": "string" } },
          "permissions": { "type": "object" },
          "source": { "type": "object" },
          "icon": {
            "type": "object",
            "required": ["url", "sha256"],
            "properties": { "url": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
          },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["target", "url", "sha256", "size"],
              "properties": {
                "target": { "type": "string" },
                "url": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "size": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "revoked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "versions", "reason"],
        "properties": {
          "id": { "type": "string" },
          "versions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "reason": { "type": "string", "minLength": 5 },
          "date": { "type": "string" }
        }
      }
    }
  }
}
